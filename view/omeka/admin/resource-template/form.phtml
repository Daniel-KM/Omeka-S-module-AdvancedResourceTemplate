<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\ResourceTemplateRepresentation $resourceTemplate
 * @var \AdvancedResourceTemplate\Form\ResourceTemplateForm $form
 * @var \AdvancedResourceTemplate\Form\ResourceTemplatePropertyFieldset $propertyFieldset
 * @var string $submitLabel
 * @var string $action
 */

// Copy of original file + use propertyFieldset + data key.

$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$formLabel = $this->plugin('formLabel');
$formElement = $this->plugin('formElement');
$api = $this->plugin('api');

$form->prepare();
$this->headScript()
    ->appendFile($this->assetUrl('vendor/sortablejs/Sortable.min.js', 'Omeka'))
    ->appendFile($this->assetUrl('js/resource-template-form.js', 'AdvancedResourceTemplate'));
?>

<?php echo $this->form()->openTag($form); ?>

<div id="page-actions">
    <?php if (isset($resourceTemplate)): ?>
    <a href="#" class="delete button sidebar-content" data-sidebar-selector="#delete"><?php echo $translate('Delete'); ?></a>
    <?php endif; ?>
    <?php echo $this->cancelButton(); ?>
    <button type="submit" class="button"><?php echo $escape($submitLabel); ?></button>
</div>

<?php
$templateSettings = $form->get('o:data');
$hasSettings = (bool) count($templateSettings->getElements());
if ($hasSettings):
    echo $this->sectionNav([
        'template-properties' => $translate('Properties'),
        'template-settings' => $translate('Template settings'),
    ]);
endif;
?>

<?php $this->trigger("view.$action.form.before", ['form' => $form]); ?>

<fieldset id="template-properties" class="section active" aria-labelledby="template-properties-label">
<legend><?= $translate('Properties') ?></legend>

<?php foreach ($form->getElements() as $element): ?>
<?php echo $this->formRow($element); ?>
<?php endforeach; ?>

<div class="property-list-toolbar">
    <button type="button" id="toggle-extended-info" class="button" aria-pressed="false"><?= $translate('Details') ?></button>
</div>

<ul id="properties" data-add-new-property-row-url="<?php echo $escape($this->url(null, ['action' => 'add-new-property-row'], true)); ?>">
    <?php foreach ($form->get('o:resource_template_property') as $propertyFieldset): ?>
    <?php $property = $propertyFieldset->get('o:property')->getValue(); ?>
    <?php $property = $api->read('properties', $property)->getContent();
    echo $this->partial(
        'omeka/admin/resource-template/show-property-row',
        ['property' => $property, 'propertyFieldset' => $propertyFieldset, 'resourceTemplate' => $resourceTemplate]
    ) ?>
    <?php endforeach; ?>
</ul>

</fieldset>

<?php if ($hasSettings): ?>
<fieldset id="template-settings" class="section" aria-labelledby="template-settings-label">
<legend><?= $translate('Template settings') ?></legend>
<?php echo $this->formCollectionElementGroups($templateSettings); ?>
</fieldset>
<?php endif; ?>

<?php $this->trigger("view.$action.form.after", ['form' => $form]); ?>

<?php echo $this->form()->closeTag(); ?>

<button id="property-selector-button" class="mobile-only button"><?php echo $translate('Add property'); ?></button>

<?php echo $this->propertySelector(); ?>
<?php if (isset($resourceTemplate)): ?>
    <?php echo $this->deleteConfirm($resourceTemplate, 'resource template'); ?>
<?php endif; ?>

<div id="details" class="sidebar">
    <?php echo $this->hyperlink('', '#', [
        'class' => 'sidebar-close o-icon-close',
        'title' => $translate('Close'),
    ]); ?>
    <div class="sidebar-content"></div>
</div>

<div id="edit-sidebar" class="sidebar">
    <div class="confirm-main">
        <?php echo $this->hyperlink('', '#', [
            'class' => 'sidebar-close o-icon-close',
            'title' => $translate('Close'),
        ]); ?>
        <div class="field">
            <h3><?= $translate('Property') ?></h3>
            <h4 id="vocabulary-label"></h4>
            <span id="property-term"></span>
        </div>
        <div class="field">
            <h3><?php echo $escape($translate('Label')); ?></h3>
            <h4><?php echo $translate('Original'); ?></h4>
            <span id="original-label"></span>
            <label for="alternate-label"><?php echo $translate('Alternate'); ?></label>
            <input id="alternate-label" type="text" data-property-key="o:alternate_label">
        </div>
        <div class="field">
            <h3><?php echo $escape($translate('Comment')); ?></h3>
            <h4><?php echo $translate('Original'); ?></h4>
            <span id="original-comment"></span>
            <label for="alternate-comment"><?php echo $translate('Alternate'); ?></label>
            <textarea id="alternate-comment" data-property-key="o:alternate_comment"></textarea>
        </div>
        <div class="field">
            <h3><?php echo $translate('Other options'); ?></h3>
            <div class="option">
                <label for="is-title-property">
                    <?php echo $translate('Use for resource title'); ?>
                    <input id="is-title-property" type="checkbox" data-property-key="is-title-property">
                </label>
            </div>
            <div class="option">
                <label for="is-description-property">
                    <?php echo $translate('Use for resource description'); ?>
                    <input id="is-description-property" type="checkbox" data-property-key="is-description-property">
                </label>
            </div>
            <div class="option">
                <label for="is-required">
                    <?php echo $translate('Required'); ?>
                    <input id="is-required" type="checkbox" data-property-key="o:is_required">
                </label>
            </div>
            <div class="option">
                <label for="is-private">
                    <?php echo $translate('Private'); ?>
                    <input id="is-private" type="checkbox" data-property-key="o:is_private">
                </label>
            </div>
            <div class="option">
                <label for="default-lang">
                    <?php echo $translate('Default language'); ?>
                </label>
                <input id="default-lang" type="text" data-property-key="o:default_lang" class="validate-language">
            </div>
            <div class="option">
                <label for="data-type"><?php echo $translate('Data types'); ?></label>
                <?php echo $this->dataType()->getSelect('data_type', null, ['id' => 'data-type', 'multiple' => true, 'class' => 'chosen-select', 'data-property-key' => 'o:data_type', 'data-placeholder' => 'Select data types…']); ?>
            </div>
        </div>
        <?php
        $elements = array_filter($propertyFieldset->getElements(), function ($element) { return $element->getAttribute('data-setting-key'); });
        if (count($elements)):
            // Group advanced settings into collapsible sections to make sidebar
            // easier to use. The core sections come first, then one section per
            // module: settings of Custom Vocab and Value Suggest are managed
            // here only because they are not integrated upstream, so they are
            // listed with the other modules. Settings that are not listed (for
            // example added by a new module) fall in the last section.
            $settingSections = [
                'Validation' => [ // @translate
                    'min_values',
                    'max_values',
                    'min_length',
                    'max_length',
                    'input_control',
                    'unique_value',
                ],
                'Automatic values' => [ // @translate
                    'default_value',
                    'automatic_value',
                    'automatic_value_issued',
                    'locked_value',
                    'property_read_only',
                ],
                'Editing' => [ // @translate
                    'split_separator',
                    'quick_new_resource',
                    'autocomplete',
                    'value_languages',
                    'use_language',
                ],
                'Linked resources' => [ // @translate
                    'resource_query',
                    'order_by_linked_resource_properties',
                ],
                'Value annotations' => [ // @translate
                    'value_annotations_template',
                ],
                'Display as record' => [ // @translate
                    'display_on_public_site',
                    'display_value',
                ],
                'Display in lists' => [ // @translate
                    'card_display',
                    'card_role',
                    'card_first_only',
                    'card_separator',
                    'card_max',
                ],
                // Custom Vocab and Value Suggest are managed here only because
                // they are not integrated upstream, so they get their own
                // section, like the other modules.
                'Custom Vocab' => [ // @translate
                    'custom_vocab_open',
                ],
                'Value Suggest' => [ // @translate
                    'value_suggest_keep_original_label',
                    'value_suggest_require_uri',
                ],
            ];
            $elementsByKey = [];
            foreach ($elements as $element) {
                $elementsByKey[$element->getAttribute('data-setting-key')] = $element;
            }
            $sections = [];
            $used = [];
            foreach ($settingSections as $sectionLabel => $keys) {
                $sectionElements = [];
                foreach ($keys as $key) {
                    if (isset($elementsByKey[$key])) {
                        $sectionElements[] = $elementsByKey[$key];
                        $used[$key] = true;
                    }
                }
                if ($sectionElements) {
                    $sections[$sectionLabel] = $sectionElements;
                }
            }
            // Modules declare their own section through the standard option
            // "element_group", so the module name is not hardcoded here. The
            // settings without any declared group end in a last section.
            $otherElements = [];
            foreach (array_diff_key($elementsByKey, $used) as $element) {
                $sectionLabel = (string) $element->getOption('element_group');
                if ($sectionLabel === '') {
                    $otherElements[] = $element;
                } else {
                    $sections[$sectionLabel][] = $element;
                }
            }
            // Keep the settings without any declared group in a last section.
            if ($otherElements) {
                $sections['Other settings'] = $otherElements; // @translate
            }
        ?>
        <div class="field settings">
            <h3><?php echo $propertyFieldset->get('o:data')->getLabel(); ?></h3>
            <?php foreach ($sections as $sectionLabel => $sectionElements): ?>
            <details class="setting-section">
                <summary><?php echo $escape($translate($sectionLabel)); ?></summary>
                <?php foreach ($sectionElements as $element): ?>
                <div class="option">
                    <?php echo $formLabel($element); ?>
                    <?php echo $formElement($element); ?>
                </div>
                <?php endforeach; ?>
            </details>
            <?php endforeach; ?>
        </div>
        <?php endif; ?>
    </div>
    <div class="confirm-panel">
        <button id="set-changes" class="button"><?php echo $translate('Set changes'); ?></button>
    </div>
</div>
