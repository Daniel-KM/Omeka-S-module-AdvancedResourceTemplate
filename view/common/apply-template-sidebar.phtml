<?php
/**
 * Sidebar partial for the ApplyTemplate job launcher.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var int $templateId Resource template id (0 from browse).
 * @var int $resourceCount Number of resources using
 *     the template.
 */

use Common\Stdlib\PsrMessage;

$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$url = $this->plugin('url');
$formElement = $this->plugin('formElement');

// Build a generic form to get the CSRF token that the
// controller expects (name "form" → element "form_csrf").
$form = new \Laminas\Form\Form('form');
$form->add(new \Laminas\Form\Element\Csrf('form_csrf'));
$form->add([
    'name' => 'fix_warning',
    'type' => \Common\Form\Element\Note::class,
    'options' => [
        'text' => 'Warning: some fixes remove values definitively, in particular the truncation, the maximum number of values and the properties that are not in the template. A backup of the database is recommended.', // @translate
    ],
]);
$form->prepare();

$formAction = $templateId
    ? $url('admin/id', ['controller' => 'resource-template', 'id' => $templateId, 'action' => 'apply-template'])
    : '#';

$baseAction = $url('admin/id', [
    'controller' => 'resource-template',
    'id' => '__ID__',
    'action' => 'apply-template',
]);
?>
<div id="apply-template-sidebar" class="sidebar"
    data-base-action="<?= $escape($baseAction) ?>">
    <div class="confirm-main">
        <?= $this->hyperlink('', '#', [
            'class' => 'sidebar-close o-icon-close',
            'title' => $translate('Close'),
        ]) ?>
        <div class="apply-template-content">
            <h3><?= $translate('Audit and fix resources') // @translate ?></h3>
            <p>
                <?= new PsrMessage(
                    $translate('{count} resources have values that may not match the current settings of this template.'), // @translate
                    ['count' => '<span class="apply-template-resource-count">'
                        . (int) $resourceCount
                        . '</span>']
                ) ?>
            </p>
            <form id="apply-template-form" method="post"
                action="<?= $escape($formAction) ?>">
                <?= $formElement($form->get('form_csrf')) ?>
                <input type="hidden" name="template_id"
                    value="<?= (int) $templateId ?>">
                <div class="field apply-template-mode">
                    <label class="radio">
                        <input type="radio" name="fix" value="0"
                            id="apply-template-mode-audit" checked>
                        <?= $translate('Audit') // @translate ?>
                    </label>
                    <label class="radio">
                        <input type="radio" name="fix" value="1"
                            id="apply-template-mode-fix">
                        <?= $translate('Apply to resources') // @translate ?>
                    </label>
                </div>
                <?php
                // Audit options provided by other modules ("check_*"). Most of
                // the checks need no option and are simply registered through
                // the event "advancedresourcetemplate.audit.checkers".
                $auditOptions = $this->trigger(
                    'advancedresourcetemplate.audit.options',
                    ['options' => []],
                    true,
                    ['AdvancedResourceTemplate']
                );
                ?>
                <?php if ($auditOptions['options']): ?>
                <fieldset id="apply-template-audit-options">
                    <?php foreach ($auditOptions['options'] as $auditOption): ?>
                    <?= $auditOption ?>
                    <?php endforeach; ?>
                </fieldset>
                <?php endif; ?>
                <fieldset id="apply-template-options" disabled hidden>
                    <?= $formElement($form->get('fix_warning')) ?>
                    <div class="field">
                        <label>
                            <input type="checkbox"
                                name="fix_default_values" value="1">
                            <?= $translate('Add missing default values') // @translate ?>
                        </label>
                    </div>
                    <div class="field">
                        <label>
                            <input type="checkbox"
                                name="fix_automatic_values" value="1">
                            <?= $translate('Recalculate automatic values') // @translate ?>
                        </label>
                    </div>
                    <div class="field">
                        <label>
                            <input type="checkbox"
                                name="fix_visibility" value="1">
                            <?= $translate('Fix visibility (public/private)') // @translate ?>
                        </label>
                    </div>
                    <div class="field">
                        <label>
                            <input type="checkbox"
                                name="fix_data_types" value="1">
                            <?= $translate('Fix wrong data types when possible') // @translate ?>
                        </label>
                    </div>
                    <?php // The fixes below remove data definitively. ?>
                    <div class="field">
                        <label>
                            <input type="checkbox"
                                name="fix_truncate" value="1">
                            <?= $translate('Truncate values exceeding max length') // @translate ?>
                        </label>
                    </div>
                    <div class="field">
                        <label>
                            <input type="checkbox"
                                name="fix_max_values" value="1">
                            <?= $translate('Remove values exceeding max count') // @translate ?>
                        </label>
                    </div>
                    <div class="field">
                        <label>
                            <input type="checkbox"
                                name="fix_extra_properties" value="1">
                            <?= $translate('Remove values of properties not in template') // @translate ?>
                        </label>
                    </div>
                    <?php
                    // Fixes provided by other modules.
                    $fixOptions = $this->trigger(
                        'advancedresourcetemplate.fix.options',
                        ['options' => []],
                        true,
                        ['AdvancedResourceTemplate']
                    );
                    foreach ($fixOptions['options'] as $fixOption) {
                        echo $fixOption;
                    }
                    ?>
                </fieldset>
            </form>
        </div>
    </div>
    <div class="confirm-panel">
        <button type="submit" form="apply-template-form"
            data-label-audit="<?= $escape($translate('Audit')) ?>"
            data-label-fix="<?= $escape($translate('Apply fixes')) ?>"
        ><?= $translate('Audit') // @translate ?></button>
    </div>
</div>
